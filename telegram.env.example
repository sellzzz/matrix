# Copy this file to telegram.env on the server and fill in your own values.
# Do not commit telegram.env or share the bot token.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# Position-change scan
SIGNAL_SCAN_URL=http://127.0.0.1:8787/api/scan?period=4h&points=5&threshold=30&maxSymbols=500

# Low-cap scan: market cap <= $100M and OI change >= 30%
SMALLCAP_SCAN_URL=http://127.0.0.1:8787/api/scan?period=4h&points=5&threshold=0&maxSymbols=500&smallCapMaxUsd=100000000&smallCapMinChange=30

# Daily key-zone signal history
REVERSAL_HISTORY_URL=http://127.0.0.1:8787/api/reversal/history?limit=500

# Realtime key-zone observation events
REVERSAL_REALTIME_URL=http://127.0.0.1:8787/api/reversal/realtime?limit=500

# Send one aggregated key-zone review every day at this Beijing-time hour (0-23)
DAILY_KEY_ZONE_REPORT_HOUR=9

# 1: keep hourly summaries, but suppress low-priority realtime stages and repeated auto attachments; 0: push every stage
TELEGRAM_QUIET_MODE=1

# Retry temporary Telegram network failures (1-5)
TELEGRAM_REQUEST_RETRIES=3

# Avoid broken IPv6 routes to Telegram. Set to 0 only when IPv6 is known to work.
TELEGRAM_FORCE_IPV4=1

# Optional: route Telegram through your own proxy or relay when api.telegram.org is unreachable.
# Never use an unknown public relay because it receives the bot token.
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_API_BASE_URL=https://your-own-relay.example.workers.dev
# TELEGRAM_RELAY_SECRET=replace_with_a_long_random_secret

# On-chain price alert events
ONCHAIN_EVENTS_URL=http://127.0.0.1:8787/api/onchain/alerts/events

# Hourly position/low-cap summary
SIGNAL_INTERVAL_MS=3600000

# Check newly recorded key-zone/on-chain events every minute
TELEGRAM_POLL_INTERVAL_MS=60000
